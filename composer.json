{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cboxdk/laravel-id-billing",
    "description": "Cbox ID billing plugin (commercial) — the SaaS billing console: plan, invoices and usage-vs-limit, on the billing client, plugged into console-kit and gated on itself. Data + UI in one drop-in package; the self-hostable app stays billing-free.",
    "keywords": ["cbox", "identity", "billing", "saas", "plugin", "laravel"],
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "cboxdk/laravel-billing-client": "^0.3",
        "cboxdk/laravel-console-kit": "^0.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "livewire/volt": "^1.6.0 || ^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Id\\Billing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Id\\Billing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "qa": ["@lint", "@analyse", "@test", "@license-check", "@composer audit --no-dev"]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Id\\Billing\\BillingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
